# ============ Backend (Render dashboard / backend/.env) ============
# LLMs - free tiers. At least one is required; Gemini is needed for screenshot analysis,
# Groq for audio transcription.
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
# Optional model overrides (change these when a provider retires a model)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-lite-latest

# MongoDB Atlas (M0 free cluster)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=cyberguard_db

# Clerk - Frontend API URL from Clerk Dashboard -> API Keys (JWKS URL is derived from it)
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
# Origins allowed to mint tokens (comma-separated)
CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app,http://localhost:3000

# CORS - your Vercel URL(s), comma-separated. Optional regex for Vercel preview deployments.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# ALLOWED_ORIGIN_REGEX=https://your-app-.*\.vercel\.app

# Optional: SerpApi (free tier) to look up bank nodal-officer contacts
# SERPAPI_API_KEY=...

# Optional free integrations
# SENTRY_DSN=https://...@sentry.io/...            # error tracking (errors only, no request bodies)
# GOOGLE_SAFE_BROWSING_KEY=...                     # link blocklist checks
# URLHAUS_AUTH_KEY=...                             # free key from auth.abuse.ch
# TELEGRAM_BOT_TOKEN=123456:ABC...                 # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=any-long-random-string
# ADMIN_USER_IDS=user_abc123                       # Clerk user ids allowed to moderate community reports
# LLM_TIMEOUT_SECONDS=45

# ============ Frontend (Vercel project settings / frontend/.env.local) ============
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
